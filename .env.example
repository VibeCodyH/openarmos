# Host and camera
TZ=America/New_York
FRIGATE_RTSP_URL=rtsp://user:password@camera.local:554/stream1

# armos agent
MQTT_URL=mqtt://mosquitto:1883
FRIGATE_EVENTS_TOPIC=frigate/events
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:14b
HA_URL=http://homeassistant:8123
# Create a Home Assistant long-lived access token. Leave blank until configured.
HA_TOKEN=
# Optional push target. When blank, armos logs notifications only.
# Example: https://ntfy.sh/openarmos-changeme
NTFY_URL=
KNOWN_FACES=alice,bob
MODE=home
ARMED_ZONES=front_gate,driveway
HA_LOCKS=lock.front_door,lock.back_door
HA_GATE=cover.driveway_gate
# Browser-reachable Frigate URL for the dashboard's clip/snapshot links.
# Use the host-published address (or your Tailscale hostname), not the compose name.
# Frigate's authenticated UI on 8971 is HTTPS with a self-signed cert.
FRIGATE_PUBLIC_URL=https://localhost:8971
PORT=8099

# --- Battery-camera mode ---------------------------------------------------
# For battery/solar cameras (a Tapo, Ring, or similar doorbell) that can't
# stream 24/7 without draining in a day or two. When on, Armos keeps these
# cameras DISABLED in Frigate so they sleep, and wakes one only for an event:
# a motion trigger hits POST /trigger (or the dashboard "Wake" button, or an
# HA/PIR automation), the camera comes up for BATTERY_ACTIVE_SECONDS, and each
# live detection extends that window. After the activity stops, it sleeps again.
# Trade-off: waking a sleeping camera takes ~5-15s, so clips start a little late.
# Leave BATTERY_MODE=false for always-on (wired/PoE) cameras.
BATTERY_MODE=false
# Comma-separated Frigate camera names to manage (case-sensitive). Only used
# when BATTERY_MODE=true.
BATTERY_CAMERAS=front_door
BATTERY_ACTIVE_SECONDS=60

# Optional faces profile
COMPREFACE_VERSION=1.2.0
COMPREFACE_DB_USER=postgres
COMPREFACE_DB_PASSWORD=change-me
COMPREFACE_DB_NAME=frs
COMPREFACE_ADMIN_JAVA_OPTS=-Xmx1g
COMPREFACE_API_JAVA_OPTS=-Xmx4g
COMPREFACE_SAVE_IMAGES=true
COMPREFACE_MAX_DETECT_SIZE=640
COMPREFACE_UWSGI_PROCESSES=2
COMPREFACE_UWSGI_THREADS=1

# Optional remote profile
# Generate a reusable or ephemeral auth key in the Tailscale admin console.
TS_AUTHKEY=
TS_HOSTNAME=openarmos
TS_EXTRA_ARGS=--accept-dns=false
